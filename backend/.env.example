# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (local example). For Render/Neon use their URL and set DB_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurak_events
DB_SSL=false

# Auth
JWT_SECRET=replace_with_32_char_random_string
JWT_EXPIRES_IN=1d

# Uploads
MAX_UPLOAD_MB=8

# Meritto CRM integration
# mock = no real calls, fake lead IDs (use until the university gives you API keys)
# live = real calls to Meritto using the values below
# off  = don't process sync jobs at all
MERITTO_MODE=mock
MERITTO_BASE_URL=https://api.nopaperforms.io
MERITTO_LEAD_PATH=/lead/v1/create
MERITTO_ACCESS_KEY=
MERITTO_SECRET_KEY=
MERITTO_SOURCE=AURAK Events Platform
CRM_WORKER_INTERVAL_MS=30000
CRM_MAX_ATTEMPTS=5
